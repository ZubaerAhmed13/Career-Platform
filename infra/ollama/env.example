# Copy to infra/ollama/.env on your independent inference server.
# Review/pin current image tags or immutable digests before use.
OLLAMA_VERSION=REPLACE_WITH_REVIEWED_VERSION
CADDY_VERSION=REPLACE_WITH_REVIEWED_VERSION
MODEL_DOMAIN=career-model.example.com
# Generate a random shared credential with: openssl rand -hex 32
INFERENCE_BEARER_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

CLAMAV_VERSION=REPLACE_WITH_SUPPORTED_VERSION
SCAN_NODE_VERSION=REPLACE_WITH_PINNED_NODE_IMAGE
CV_SCAN_BEARER_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_TOKEN
