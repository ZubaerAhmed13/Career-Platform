# CareerOS AI Supabase project — the URL is public.
NEXT_PUBLIC_SUPABASE_URL=https://jtitfwzpfbyfsdpxxrbj.supabase.co
# Copy your sb_publishable_... value into .env.local or deployment environment.
# Do not commit .env.local and never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY
# Change to the actual deployed origin when releasing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted Qwen3 / Ollama inference. NO external AI provider key.
# In Vercel preview/production use a TLS-only domain, not localhost.
# Ollama must sit behind a restricted gateway (see infra/ollama).
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_MODEL=qwen3:8b
# Server-side gateway authorization secret (not a paid-model API key).
SELF_HOSTED_LLM_TOKEN=

# Optional: internal ClamAV clamd TCP endpoint for fail-closed PDF/DOCX extraction
# Never expose the scanner over public internet; require the private application network.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Privileged database key is SERVER-ONLY and required for verified AI provenance
# AND self-service hard account deletion; never copy into browser code.
# Obtain from Supabase project API keys; never prefix with NEXT_PUBLIC_, share,
# commit or log this value. Required only for AI interview/extraction.
SUPABASE_SERVICE_ROLE_KEY=

# Protected Vercel -> HTTPS scanner; never use direct clamd TCP on Vercel.
CV_SCAN_GATEWAY_URL=
CV_SCAN_GATEWAY_TOKEN=
